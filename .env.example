# New Relic ingest license key (type: INGEST - LICENSE). Used by both the PHP agent and OTLP.
NEW_RELIC_LICENSE_KEY=

# Toggle each pipeline independently to compare / isolate them
NEW_RELIC_ENABLED=true
OTEL_SDK_DISABLED=false

# Entity names shown in New Relic (kept different so the two show up side by side)
NEW_RELIC_APP_NAME=laravel-octane-nr-agent
OTEL_SERVICE_NAME=laravel-octane-nr-otel

# US: https://otlp.nr-data.net:4318 / EU: https://otlp.eu01.nr-data.net:4318
OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp.nr-data.net:4318

OCTANE_WORKERS=2
OCTANE_TASK_WORKERS=4
